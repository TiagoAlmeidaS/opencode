# =============================================================================
# Flutter Web — Build + Serve via nginx
# =============================================================================
# Stage 1: Build Flutter web app
FROM ghcr.io/cirruslabs/flutter:stable AS builder

WORKDIR /flutter_app

# Copy only Flutter app sources (no monorepo TS dependencies needed)
COPY packages/flutter_app/pubspec.yaml packages/flutter_app/pubspec.lock ./
RUN flutter pub get

COPY packages/flutter_app/ .
RUN flutter build web --release --no-tree-shake-icons

# =============================================================================
# Stage 2: Serve with nginx
FROM nginx:alpine

# SPA routing: all paths → index.html
COPY --from=builder /flutter_app/build/web /usr/share/nginx/html

RUN printf 'server {\n\
    listen 80;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
    # Cache static assets aggressively\n\
    location ~* \\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, immutable";\n\
    }\n\
    # No cache for index.html\n\
    location = /index.html {\n\
        add_header Cache-Control "no-cache, no-store, must-revalidate";\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
