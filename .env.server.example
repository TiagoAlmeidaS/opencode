# =============================================================================
# OpenCode Server — Variáveis de ambiente
# Copie para .env.server e preencha antes de subir o docker compose
# =============================================================================

# ── Porta HTTP do server (exposta no host) ──────────────────────────────────
SERVER_PORT=3000

# ── Domínio (para Traefik/Nginx) ────────────────────────────────────────────
SERVER_DOMAIN=opencode.seudominio.com
RABBITMQ_DOMAIN=rabbitmq.seudominio.com

# ── LLM — pipelines de memória (memory_extract, memory_consolidation) ─────────
# Prioridade: ANTHROPIC_API_KEY (pago) > OPENROUTER_API_KEY (free) > nenhum (heurísticas)
#
# Opção 1 — Somente heurísticas (zero custo): deixe AMBOS vazios.
#   memory_extract/consolidation rodam sem chamar API (transcript bruto + merge simples).
#
# Opção 2 — LLM free: use OpenRouter. Crie chave em https://openrouter.ai/keys
#   OPENROUTER_MODEL=openrouter/free usa o router gratuito do OpenRouter.
#   Alternativas: google/gemini-2.0-flash-exp:free, meta-llama/llama-3.1-8b-instruct:free
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openrouter/free
#
# Opção 3 — LLM pago (melhor qualidade): Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-4-5-20251001

# ── Telegram — relatórios automáticos ───────────────────────────────────────
# 1. Crie um bot em @BotFather e copie o token
# 2. Adicione o bot ao canal/grupo e copie o chat_id (pode ser negativo para grupos)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── GitHub — para pipeline de scanning de bounties ──────────────────────────
# Personal Access Token com permissão read:public_repo (ou sem permissão para repos públicos)
GITHUB_TOKEN=ghp_...

# ── API Authentication ───────────────────────────────────────────────────────
# Token para proteger a API (recomendado em produção)
# Acesse via: Authorization: Bearer <token>
API_TOKEN=mude-para-um-token-seguro

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origens permitidas. Use * para desenvolvimento, domínio específico em produção
CORS_ORIGIN=*

# ── Tailscale / VPS — Qdrant e Postgres (RAG e memória) ───────────────────────
# IP da VPS na rede Tailscale (ex.: 100.98.213.86). Troque SUA_SENHA_POSTGRES pela senha real.
QDRANT_URL=http://100.98.213.86:6333
POSTGRES_URL=postgres://jarvis:SUA_SENHA_POSTGRES@100.98.213.86:5432/jarvis?sslmode=disable

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=opencode
RABBITMQ_PASS=opencode_change_me
RABBITMQ_VHOST=opencode
