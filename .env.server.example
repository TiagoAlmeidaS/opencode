# =============================================================================
# OpenCode Server — Variáveis de ambiente
# Copie para .env.server e preencha antes de subir o docker compose
# =============================================================================

# ── Porta HTTP do server (exposta no host) ──────────────────────────────────
SERVER_PORT=3000

# ── Domínio (para Traefik/Nginx) ────────────────────────────────────────────
SERVER_DOMAIN=opencode.seudominio.com
RABBITMQ_DOMAIN=rabbitmq.seudominio.com

# ── LLM — Anthropic API key para scoring/análise via IA ─────────────────────
# Deixe vazio para usar somente heurísticas (sem custo)
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5-20251001

# ── Telegram — relatórios automáticos ───────────────────────────────────────
# 1. Crie um bot em @BotFather e copie o token
# 2. Adicione o bot ao canal/grupo e copie o chat_id (pode ser negativo para grupos)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── GitHub — para pipeline de scanning de bounties ──────────────────────────
# Personal Access Token com permissão read:public_repo (ou sem permissão para repos públicos)
GITHUB_TOKEN=ghp_...

# ── API Authentication ───────────────────────────────────────────────────────
# Token para proteger a API (recomendado em produção)
# Acesse via: Authorization: Bearer <token>
API_TOKEN=mude-para-um-token-seguro

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origens permitidas. Use * para desenvolvimento, domínio específico em produção
CORS_ORIGIN=*

# ── Qdrant (RAG) ─────────────────────────────────────────────────────────────
# URL do Qdrant para memory RAG. Deixe vazio se não usar.
# Se usar docker-compose.vps.yml junto, use: http://qdrant:6333
QDRANT_URL=

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=opencode
RABBITMQ_PASS=opencode_change_me
RABBITMQ_VHOST=opencode
