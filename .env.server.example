# =============================================================================
# OpenCode Server — Variáveis de ambiente
# Copie para .env.server e preencha antes de subir o docker compose
# =============================================================================

# ── Porta HTTP do server (exposta no host) ──────────────────────────────────
SERVER_PORT=3000

# ── Domínio (para Traefik/Nginx) ────────────────────────────────────────────
SERVER_DOMAIN=opencode.seudominio.com
RABBITMQ_DOMAIN=rabbitmq.seudominio.com

# URL pública exibida no log ao subir (ex: http://76.13.96.99:3000). Opcional.
# PUBLIC_URL=http://76.13.96.99:3000

# ── LLM — Default (provider para análise, memória, scoring) ──────────────────
# MEMORY_LLM_PROVIDER: controla o backend padrão para Activities/Pipelines.
# Opcoes: anthropic | azure | openai | openrouter | heuristic
# Se nao definido: prioridade Anthropic > OpenRouter > heuristicas.
MEMORY_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o-mini
#
# Outros providers (descomente se preferir):
# MEMORY_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-4-5-20251001
#
# MEMORY_LLM_PROVIDER=azure
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_BASE_URL=https://xxx.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=nome-do-deployment

# ── CLI coding sessions — modelo padrão para implement-code ───────────────────
# Define o modelo usado pelo OpenCode CLI em TODAS as sessões de coding.
# Use IDs com ponto (4.5), nao hifen (4-5). Ex: anthropic/claude-sonnet-4.5
OPENCODE_CONFIG_CONTENT={"model":"openrouter/anthropic/claude-sonnet-4.5"}

# ── Multi-LLM Routing (v2.0.0) — mapeamento por tipo de operação ──────────────
#
# Cada TaskType pode ter seu próprio LLM. Se não configurado, usa o default acima.
# Estratégia recomendada:
#   coding   → CLI usa OPENCODE_CONFIG_CONTENT (não precisa de LLM_CODING_* para o default)
#   spec     → modelo poderoso para geração de specs detalhadas
#   analysis → modelo barato (default é suficiente)
#   memory   → modelo barato (default é suficiente)
#   docs     → modelo intermediário
#
# Formato das vars por tipo:
#   LLM_<TYPE>_PROVIDER   anthropic | openai | (auto: openai-compatible quando BASE_URL presente)
#   LLM_<TYPE>_MODEL      model id (ex: anthropic/claude-sonnet-4.5, gpt-4o-mini)
#   LLM_<TYPE>_API_KEY    opcional — herda a key do provider se omitido
#   LLM_<TYPE>_BASE_URL   ativa openai-compatible automaticamente (ex: OpenRouter, KIMI, DeepSeek)
#
# Exemplos:

# spec — modelo forte para specs (OpenRouter claude-sonnet-4.5)
# LLM_SPEC_BASE_URL=https://openrouter.ai/api/v1
# LLM_SPEC_MODEL=anthropic/claude-sonnet-4.5
# LLM_SPEC_API_KEY=sk-or-v1-...

# docs — modelo barato para documentação (OpenRouter gpt-4o-mini)
# LLM_DOCS_BASE_URL=https://openrouter.ai/api/v1
# LLM_DOCS_MODEL=openai/gpt-4o-mini
# LLM_DOCS_API_KEY=sk-or-v1-...

# coding — sobrescreve o modelo CLI por job (ex: KIMI para codificação)
# LLM_CODING_BASE_URL=https://api.moonshot.cn/v1
# LLM_CODING_MODEL=moonshot-v1-128k
# LLM_CODING_API_KEY=sk-moonshot-...

# analysis — modelo barato para scoring (Anthropic Haiku)
# LLM_ANALYSIS_PROVIDER=anthropic
# LLM_ANALYSIS_MODEL=claude-haiku-4-5-20251001
# LLM_ANALYSIS_API_KEY=sk-ant-...

# ── Telegram — relatórios automáticos ───────────────────────────────────────
# 1. Crie um bot em @BotFather e copie o token
# 2. Adicione o bot ao canal/grupo e copie o chat_id (pode ser negativo para grupos)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── GitHub — scanning de bounties + PR automático + criação de repos ────────
# Personal Access Token com permissões: repo (para fork/PR) + read:user
# Também usado pelo OpenCode em POST /project/add-by-url (clone) SE este valor
# estiver no ambiente do processo que corre opencode serve (ex.: via env_file no Docker).
GITHUB_TOKEN=ghp_...

# ── SendGrid — envio de emails de proposta freelance ────────────────────────
SENDGRID_API_KEY=SG.xxxx
SENDGRID_FROM_EMAIL=agent@seudominio.com

# ── Bounty / Pagamento (endereços públicos para recebimento) ─────────────────
# NUNCA coloque chaves privadas ou seed phrase. O agente só precisa do endereço público.
# EVM (MetaMask, Rabby): Ethereum, Polygon, Arbitrum, Base, BSC — USDC/USDT
EVM_WALLET_ADDRESS=0x...
# TON (Tonkeeper) — ecossistema Telegram
# TON_WALLET_ADDRESS=EQ...
# Bitcoin (Bech32, bc1q)
# BTC_WALLET_ADDRESS=bc1q...
# Tron (TRX, USDT)
# TRON_WALLET_ADDRESS=T...

# ── Pipelines padrão ────────────────────────────────────────────────────────
# false = não criar automaticamente daily/weekly report na primeira subida
# SEED_DEFAULT_PIPELINES=false

# ── Execute Opportunity (opencode CLI) ────────────────────────────────────────
# Caminho do executável opencode para a activity execute-opportunity.
# No Docker, já vem definido. Em dev local, use "opencode" se estiver no PATH.
# OPENCODE_CLI_PATH=/app/bin/opencode-wrap

# ── API Authentication ───────────────────────────────────────────────────────
# Token para proteger a API (recomendado em produção)
# Acesse via: Authorization: Bearer <token>
# O dashboard injeta esse token automaticamente (DASHBOARD_INJECT_TOKEN=false para desativar)
API_TOKEN=mude-para-um-token-seguro

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origens permitidas. Use * para desenvolvimento, domínio específico em produção
CORS_ORIGIN=*

# ── Tailscale / VPS — Qdrant e Postgres (RAG e memória) ───────────────────────
# IP da VPS na rede Tailscale (ex.: 100.98.213.86). Troque SUA_SENHA_POSTGRES pela senha real.
QDRANT_URL=http://100.98.213.86:6333
POSTGRES_URL=postgres://jarvis:SUA_SENHA_POSTGRES@100.98.213.86:5432/jarvis?sslmode=disable

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=opencode
RABBITMQ_PASS=opencode_change_me
RABBITMQ_VHOST=opencode
