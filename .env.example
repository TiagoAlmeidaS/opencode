# OpenCode — copy to .env and fill with your values. Do not commit .env.

# Azure OpenAI (provider azure; model: azure/<deployment-name>)
# AZURE_RESOURCE_NAME=
# AZURE_API_KEY=

# Telegram (plugin + daily_notifier pipeline)
OPENCODE_TELEGRAM_BOT_TOKEN=
OPENCODE_TELEGRAM_CHAT_ID=

# Optional: migration from Jarvis — same values, legacy names supported as fallback
# JARVIS_TELEGRAM_BOT_TOKEN=
# JARVIS_TELEGRAM_CHAT_ID=

# WhatsApp (plugin)
OPENCODE_WHATSAPP_ACCESS_TOKEN=
OPENCODE_WHATSAPP_PHONE_NUMBER_ID=
OPENCODE_WHATSAPP_TO_NUMBER=

# OpenCode serve (optional)
# OPENCODE_SERVER_PASSWORD=
# OPENCODE_SERVER_USERNAME=
